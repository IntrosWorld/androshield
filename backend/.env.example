# Copy to .env and fill in. The app runs without these (template-fallback report),
# but Gemini-generated reports require a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional — free key at https://www.virustotal.com/gui/my-apikey (4 req/min, 500/day).
# When set, the analyzer corroborates its verdict with real multi-engine detections.
VT_API_KEY=

# Request hardening. Keep CORS restricted to the dashboard origins unless a trusted
# reverse proxy uses another explicit origin.
MAX_UPLOAD_MB=200
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Bounded agentic investigation. Disabled by default. The local agent receives only
# extracted evidence and may call only server-defined read-only tools. It never executes
# an APK or changes the deterministic score.
AGENT_ENABLED=false
AGENT_AUTO_RUN=false
AGENT_PROVIDER=ollama
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=4
AGENT_TIME_BUDGET_SECONDS=420
AGENT_PROVIDER_TIMEOUT_SECONDS=240
AGENT_CONTEXT_TOKENS=4096
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Optional second-pass cloud review of local agent hypotheses. Only the redacted
# extracted-findings bundle is sent to Gemini.
AGENT_GEMINI_REVIEW=false
