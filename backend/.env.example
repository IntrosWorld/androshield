# Copy to .env and fill in. The app runs without these (template-fallback report),
# but Gemini-generated reports require a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional — free key at https://www.virustotal.com/gui/my-apikey (4 req/min, 500/day).
# When set, the analyzer corroborates its verdict with real multi-engine detections.
VT_API_KEY=
