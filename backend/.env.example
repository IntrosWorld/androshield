# Copy to .env and fill in. The app runs without these (template-fallback report),
# but Gemini-generated reports require a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Persistence. Leave unset for the zero-setup local SQLite database. For deployed
# or multi-user environments use PostgreSQL (a Neon pooled URL works directly).
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=300

# Optional hosted open-weight inference. Only extracted findings are sent. Keep ZDR
# enabled unless you have explicitly accepted a provider's retention policy.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-8b-instruct
OPENROUTER_ZDR=true
# Qwen's JSON tool envelope is more reliable on some OpenRouter endpoints. Leave
# unset for automatic model-specific behavior; set true only after provider testing.
# OPENROUTER_NATIVE_TOOLS=false

# Optional — free key at https://www.virustotal.com/gui/my-apikey (4 req/min, 500/day).
# When set, detections appear as separate external context. They never modify the
# platform's local score, severity, or verdict.
VT_API_KEY=

# Optional override for the local static ML artifact. If unset, the bundled rich
# model is preferred and the legacy permission-only model is used as fallback.
# Joblib uses Python deserialization: load only an artifact you trained or trust.
APK_STATIC_MODEL_PATH=

# Request hardening. Keep CORS restricted to the dashboard origins unless a trusted
# reverse proxy uses another explicit origin.
MAX_UPLOAD_MB=200
MAX_BATCH_APKS=20
MAX_BATCH_TOTAL_MB=1000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# CPU-heavy static pipelines run in worker threads behind this process-local limit.
# Additional dashboard submissions remain queued in SQLite up to the queue limit.
STATIC_ANALYSIS_CONCURRENCY=2
STATIC_ANALYSIS_QUEUE_LIMIT=20

# Bounded agentic investigation. Disabled by default. The local agent receives only
# extracted evidence and may call only server-defined read-only tools. It never executes
# an APK or changes the deterministic score.
AGENT_ENABLED=false
# Optional closed-loop planner. Keeps existing evidence and manual sandbox controls
# unchanged; every emulator action still requires an explicit per-action approval.
AGENT_WORKFLOW_ENABLED=false
AGENT_AUTO_RUN=false
AGENT_PROVIDER=ollama
AGENT_OLLAMA_FALLBACK=false
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=4
AGENT_TIME_BUDGET_SECONDS=420
AGENT_PROVIDER_TIMEOUT_SECONDS=240
AGENT_CONTEXT_TOKENS=4096
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Optional second-pass cloud review of local agent hypotheses. Only the redacted
# extracted-findings bundle is sent to Gemini.
AGENT_GEMINI_REVIEW=false

# Optional Android UI exploration during an explicitly started dynamic-analysis run.
# The agent is restricted to the dedicated FraudSandbox AVD, synthetic profile fields,
# allowlisted taps/typing/back/wait actions, and a complete action audit.
UI_AGENT_ENABLED=false
UI_AGENT_PROVIDER=ollama
UI_AGENT_MODEL=qwen3-vl:2b-instruct
UI_AGENT_VISION_ENABLED=false
UI_AGENT_IMAGE_MAX_EDGE=384
UI_AGENT_MAX_OUTPUT_TOKENS=512
UI_AGENT_MAX_STEPS=8
UI_AGENT_TIME_BUDGET_SECONDS=300

# Personal AndroZoo research API key. Never commit or share this value. This key is
# used only by backend/tools/androzoo_pipeline.py; the web application does not expose it.
ANDROZOO_API_KEY=
